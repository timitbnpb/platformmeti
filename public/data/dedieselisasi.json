{"lapis":"publik","dibangun_pada":"2026-11-08","tahun_data":2024,"tingkat_bukti":"hipotesis","jumlah":38,"harga_solar":{"produk":"Dexlite (CN 51)","rp_per_liter":23700,"berlaku_sejak":"2026-09-01","wilayah":"Jabodetabek (laman Pertamina)","sumber_url":"https://www.antaranews.com/berita/5719721","pembanding_subsidi":{"produk":"Biosolar / Solar subsidi","rp_per_liter":6800,"berlaku_sejak":"2026-08-01"}},"asumsi":{"sfc_l_kwh":0.28,"kurs":16000,"efisiensi_sistem":0.8,"biaya_sen_usd_kwh":{"rendah":14,"dasar":18,"tinggi":24},"pangsa":[0.25,0.5,0.75]},"bobot_prioritas":{"pangsa":0.4,"liter":0.3,"bpp":0.2,"pvout":0.1},"metode":{"rumus":["Energi diganti (kWh) = produksi PLTD tahunan (GWh) x 1 juta x pangsa diganti.","Solar hemat (liter) = energi diganti x konsumsi spesifik PLTD (liter per kWh).","Hemat BBM (Rp) = solar hemat x harga Dexlite terbaru.","Biaya PLTS + baterai (Rp) = energi diganti x biaya (sen USD per kWh) x kurs.","Hemat bersih = hemat BBM dikurangi biaya PLTS + baterai.","PLTS dibutuhkan (MWp) = energi diganti / (PVOUT provinsi x efisiensi sistem) / 1000."],"prioritas":"Skor 0-100 = rata-rata berbobot dari pangsa PLTD dalam produksi PLN (0,4), log produksi PLTD (0,3), BPP tertinggi sistem terisolasi (0,2), dan PVOUT (0,1), masing-masing min-maks antar provinsi; komponen kosong dikeluarkan dan bobot dihitung ulang."},"sumber":[{"id":"stat","judul":"Statistik Ketenagalistrikan 2024, Ditjen Ketenagalistrikan ESDM (kapasitas dan produksi PLTD per provinsi)","url":"https://gatrik.esdm.go.id/gatrik/gatrik-api//storage/migrasi/download_index/files/91fa8-buku-statistik-ketenagalistrikan-2024.pdf","tanggal":"2026-11-07"},{"id":"bpp","judul":"Kepmen ESDM 169.K/HK.02/MEM.M/2021 (BPP 2020 per sistem dan sub sistem terisolasi), lewat peluang.json","url":"/investasi#peluang","tanggal":"2026-11-07"},{"id":"ruptl","judul":"RUPTL PLN 2025-2034: proyek bernama Dedieselisasi atau Isolated","url":"https://gatrik.esdm.go.id/","tanggal":"2026-11-07"},{"id":"solar","judul":"Harga De