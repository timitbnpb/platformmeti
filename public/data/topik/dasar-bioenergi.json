sehatan \"Kasa Husada\", Industri Kulit, Industri Pemintalan, Industri Pertenunan Dan Perajutan, Industri Makanan Dan Minuman Industri Keramik, Industri Logam Dan Mesin, Industri Kimia, Industri Kayu Bahan Bangunan Dan Sabut, Industtri Karet, Industri Nabati Dan Industri Es Dan Peleburannya Kedalam Beberapa Perusahaan Daerah","status":"berlaku","tanggal":"1965-04-07","url":"https://peraturan.bpk.go.id/Details/71303","pdf":"https://peraturan.bpk.go.id/Download/61777/pp%20no%20016%20tahun%201965.pdf","diambil":"2026-11-07"},{"id":"pp-190-1961","jenis":"pp","nomor":"190","tahun":1961,"judul":"Pendirian Perusahaan Negara Industri Minyak Nabati","status":"berlaku","tanggal":"1961-05-12","url":"https://peraturan.bpk.go.id/Details/75433","pdf":"https://peraturan.bpk.go.id/Download/65977/pp%20no%20190%20tahun%201961.pdf","diambil":"2026-11-07"}],"inovasi":[{"id":"in_bioavtur_jelantah_undip","nama":"Bahan bakar pesawat dari minyak jelantah","jenis":"proses","status":"purwarupa","tahun":2024,"ringkasan":"Penelitian Anggun Puspitarini Siswanto dari Sekolah Vokasi UNDIP mengubah metil ester minyak jelantah menjadi bioavtur lewat reaktor ozonolisis nano bubble. Riset didanai LPDP melalui program RIIM BRIN 2023 sampai 2025.","pembuat":["Universitas Diponegoro"],"trl":null,"url":"https://undip.ac.id/language/en/post/36530/innovative-young-vocational-school-undip-lecturer-owner-of-11-granted-patents-develops-airplane-fuel-from-used-cooking-oil.html","tanggal":"2026-11-08"},{"id":"in_biodigester_kopi_sumberdem","nama":"Biodigester kulit kopi dan kotoran ternak","jenis":"sistem","status":"terpasang","tahun":2026,"ringkasan":"Tim Revolusi Kopi dari IPB University dan Universitas Negeri Malang memasang biodigester tipe kantong di Desa Sumberdem, Kabupaten Malang, memakai kulit kopi dan kotoran ternak. Selain biogas, proses menghasilkan bio-slurry untuk pupuk organik.","pembuat":["IPB University"],"trl":null,"url":"https://www.ipb.ac.id/news/index/2026/09/revolusi-kopi-ipb-university-dan-um-ubah-limbah-kopi-dan-ternak-menjadi-energi-bersih-di-sumberdem/","tanggal":"2026-11-08"},{"id":"in_biogas_its","nama":"Alat pemurnian biogas ITS","jenis":"alat","status":null,"tahun":2017,"ringkasan":"Sistem Pemurnian Biogas Otomatis dengan Teori Kelarutan Gas oleh Air, karya tim Departemen Teknik Instrumentasi ITS yang dipimpin Arief Abdurrakhman bersama lima mahasiswa. Alat ini pertama hadir pada 2017 dan memperoleh paten dari Direktorat Jenderal Kekayaan Intelektual. Dirancang berskala rumah tangga agar peternak sapi dapat mengubah biogas kotoran sapi menjadi listrik.","pembuat":["Institut Teknologi Sepuluh Nopember"],"trl":null,"url":"https://www.its.ac.id/kembangkan-alat-pemurnian-biogas-dosen-its-berhasil-raih-paten/","tanggal":"2026-11-08"},{"id":"in_chpp_ipb","nama":"Combined heat, power and product (CHPP)","jenis":"proses","status":null,"tahun":2026,"ringkasan":"Combined Heat, Power and Product (CHPP) adalah konsep Prof Edy Hartulistiyoso dari IPB University untuk memanfaatkan panas sisa industri menjadi listrik dan produk bernilai tambah seperti biochar dan bio-oil. Konsep dipaparkan pada Orasi Ilmiah Guru Besar di Kampus IPB Dramaga.","pembuat":["IPB University"],"trl":null,"url":"https://www.ipb.ac.id/news/index/2026/05/prof-edy-hartulistiyoso-panas-sisa-industri-bisa-diubah-jadi-listrik-dan-biochar/","tanggal":"2026-11-08"},{"id":"in_dipofuel_gen3","nama":"Dipofuel Gen 3","jenis":"alat","status":null,"tahun":2026,"ringkasan":"Mesin Pirolisis Statis Dipofuel Generasi Ketiga mengubah limbah plastik menjadi bahan bakar cair, dikembangkan tim Prof. Didi Dwi Anggoro dari Teknik Kimia UNDIP. Kapasitasnya naik dari 5 kilogram pada prototipe pertama menjadi 100 kilogram pada generasi kedua dan 200 kilogram per produksi pada generasi ketiga.","pembuat":["Universitas Diponegoro"],"trl":null,"url":"https://undip.ac.id/post/59863/mesin-pirolisis-dipofuel-gen-3-undip-ubah-sampah-plastik-jadi-bahan-bakar.html","tanggal":"2026-11-08"},{"id":"in_nyamplung_biogas_mesin_tani","nama":"Minyak nyamplung dan biogas untuk mesin pertanian","jenis":"proses","status":"purwarupa","tahun":2026,"ringkasan":"Prof Desrial dari IPB University mengembangkan minyak nyamplung murni sebagai bahan bakar mesin diesel pertanian dan konverter biogas untuk motor bakar bensin. Riset ini masuk daftar 104 inovasi paling prospektif di Indonesia.","pembuat":["IPB University"],"trl":null,"url":"https://www.ipb.ac.id/news/index/2026/01/inovasi-prof-desrial-nyamplung-dan-biogas-jadi-bahan-bakar-mesin-pertanian/","tanggal":"2026-11-08"},{"id":"in_pengering_rumput_laut_brebes","nama":"Pengering rumput laut surya-biomassa","jenis":"alat","status":"terpasang","tahun":2026,"ringkasan":"Unit Pengering Rumput Laut Surya-Biomassa dengan Dehumidifikasi Udara dikembangkan tim Prof. Moh. Djaeni dari UNDIP bersama Unwahas. Unit diresmikan di Desa Randusanga Kulon, Brebes, bersama Ditjen PDSPKP Kementerian Kelautan dan Perikanan serta pemerintah daerah.","pembuat":["Universitas Diponegoro"],"trl":null,"url":"https://undip.ac.id/post/59212/peneliti-undip-terapkan-teknologi-pengering-rumput-laut-surya-biomassa-tingkatkan-nilai-tambah-produk-budidaya-kelautan-di-pesisir-brebes.html","tanggal":"2026-11-08"}],"berita":[{"id":"dcdc6a61a8","judul":"PLN EPI bidik pemanfaatan biomassa 10 juta ton per tahun","url":"https://www.antaranews.com/berita/5838399/pln-epi-bidik-pemanfaatan-biomassa-10-juta-ton-per-tahun","media":"Antara","terbit":"2026-11-07","diambil":"2026-11-07"},{"id":"c653551c7e","judul":"PLN EPI Targetkan 10 Juta Ton Biomassa per Tahun, Buka Peluang 150 Ribu Lapangan Kerja Hijau","url":"https://www.ruangenergi.com/pln-epi-targetkan-10-juta-ton-biomassa-per-tahun-buka-peluang-150-ribu-lapangan-kerja-hijau/","media":"Ruang Energi","terbit":"2026-11-07","diambil":"2026-11-07"},{"id":"d2fb53952b","judul":"Bahan Baku Bioetanol Terbatas , Kemenko Pangan Hitung Ulang Target E50","url":"https://www.liputan6.com/bisnis/read/8329901/bahan-baku-bioetanol-terbatas-kemenko-pang