:"https://peraturan.bpk.go.id/Details/27178","pdf":"https://peraturan.bpk.go.id/Download/16018/Perbup%2018%20Th%202011.pdf","diambil":"2026-11-07"},{"id":"permen-esdm-30-2006","jenis":"permen","nomor":"30","tahun":2006,"judul":"Penetapan dan Pemberlakuan Standar Kompetensi Tenaga Teknik Ketenagalistrikan Bidang Pembangkitan Energi Baru dan Terbarukan, Pembangkit Listrik tenaga Mikro Hidro (PLTMH), Pembangkit Listrik Tenaga Biomassa (PLTBM), pembangkit Listrik Tenaga bayu (PLTB) dan Pembangkit Listrik Tenaga Surya (PLTS)","status":"dicabut","tanggal":"2006-05-08","url":"https://peraturan.bpk.go.id/Details/143855","pdf":"https://peraturan.bpk.go.id/Download/135391/Permen%20ESDM%20Nomor%2030%20Tahun%202006.pdf","diambil":"2026-11-07"}],"inovasi":[{"id":"in_agrivoltaik_pengisian_motor","nama":"Sistem pengisian motor listrik berbasis agri-photovoltaic","jenis":"sistem","status":"purwarupa","tahun":2026,"ringkasan":"Proyek Establishment of Agrivoltaics-based Electric Motorcycle Charging System in Indonesia dikerjakan IPB University bersama Korea Energy Agency dan ENVELOPS Co, Ltd. Proyek melanjutkan Agri-Photovoltaic Research Station yang diresmikan di Kebun Pendidikan Cikabayan IPB pada 2025.","pembuat":["IPB University"],"trl":null,"url":"https://www.ipb.ac.id/news/index/2026/06/ipb-university-korea-selatan-siap-kembangkan-sistem-pengisian-motor-listrik-berbasis-agri-photovoltaic/","tanggal":"2026-11-08"},{"id":"in_buggy_hybrid_undip","nama":"Buggy car hybrid tenaga surya","jenis":"produk","status":"uji lapangan","tahun":2025,"ringkasan":"Buggy car hybrid bertenaga motor listrik dan panel surya berkapasitas hingga 8 penumpang, dikembangkan dosen dan mahasiswa Sekolah Vokasi UNDIP di Teaching Factory Manufacture. Uji coba perdana dilakukan di kampus Tembalang pada Agustus 2025.","pembuat":["Universitas Diponegoro"],"trl":null,"url":"https://undip.ac.id/post/50326/buggy-car-hybrid-sekolah-vokasi-undip-inovasi-ramah-lingkungan-berbasis-energi-surya.html","tanggal":"2026-11-08"},{"id":"in_charging_surya_gebang_putih","nama":"Charging station panel surya kendaraan listrik roda dua","jenis":"sistem","status":"terpasang","tahun":2025,"ringkasan":"Prodi Teknik Mekatronika PENS menyerahkan charging station panel surya untuk kendaraan listrik roda dua kepada Kelurahan Gebang Putih, Sukolilo, Surabaya, pada 17 Oktober 2025. Ini pengembangan dari charging station ponsel yang dipasang tahun sebelumnya.","pembuat":["Politeknik Elektronika Negeri Surabaya"],"trl":null,"url":"https://www.pens.ac.id/2025/11/12/manfaatkan-fungsi-tenaga-surya-pens-kembangkan-inovasi-charging-station-bagi-kelurahan-gebang-putih/","tanggal":"2026-11-08"},{"id":"in_charging_surya_mangrove_wonorejo","nama":"Charging station surya kapal wisata mangrove","jenis":"sistem","status":"terpasang","tahun":2026,"ringkasan":"Prodi Sarjana Terapan Teknik Mekatronika PENS menyerahkan charging station portabel tenaga surya kepada pengelola Taman Ekowisata Mangrove Wonorejo, Surabaya, pada 20 Oktober 2026. Alat dipasang di perahu wisata untuk penerangan, pengisian ponsel, dan pompa air.","pembuat":["Politeknik Elektronika Negeri Surabaya"],"trl":null,"url":"https://www.pens.ac.id/2026/10/24/dukung-operasional-kapal-wisata-mangrove-wonorejo-prodi-sarjana-terapan-teknik-mekatronika-pens-hadirkan-charging-station-tenaga-surya/","tanggal":"2026-11-08"},{"id":"in_desalinasi_surya_nusakambangan","nama":"Desalinasi bertenaga surya Nusakambangan","jenis":"sistem","status":"terpasang","tahun":2026,"ringkasan":"Instalasi desalinasi air laut bertenaga surya buatan UNDIP memasok lebih dari 20 ribu liter air minum per hari di Nusakambangan untuk penghuni lapas dan petugas. Teknologi dikembangkan Prof. Nyoman Widiasa dari Teknik Kimia UNDIP, yang juga mendampingi pembangunan dan operasional.","pembuat":["Universitas Diponegoro"],"trl":null,"url":"https://undip.ac.id/post/57116/desalinasi-undip-pasok-20-ribu-liter-air-minum-per-hari-di-nusakambangan.html","tanggal":"2026-11-08"},{"id":"in_irigasi_pintar_sre_undip","nama":"Smart irrigation tenaga surya SRE Undip","jenis":"sistem","status":"terpasang","tahun":2026,"ringkasan":"SMART PLTS IoT adalah sistem irigasi otomatis bertenaga surya buatan mahasiswa Society of Renewable Energy UNDIP bersama NGO Desabumi. Sistem diterapkan di Mangunsari, Semarang, dan diserahkan kepada Kelompok Tani Teger 02. Pengairan berjalan otomatis menurut kelembapan tanah dan dipantau lewat telepon pintar.","pembuat":["Society of Renewable Energy Universitas Diponegoro"],"trl":null,"url":"https://undip.ac.id/post/58280/sre-undip-kembangkan-smart-irrigation-bertenaga-surya-bantu-petani-mangunsari-untuk-hemat-air-dan-energi.html","tanggal":"2026-11-08"},{"id":"in_palka_pendingin_surya","nama":"Palka Pendingin Tenaga Surya (PPTS)","jenis":"sistem","status":"uji lapangan","tahun":2025,"ringkasan":"Palka Pendingin Tenaga Surya (PPTS) dikembangkan tim Dr Ayi Rahmat dari FPIK IPB University untuk kapal nelayan kecil. Sistem diuji pada tiga kapal 7 sampai 9 meter dan disebut menekan biaya operasional nelayan hingga 30 persen karena tidak membeli es.","pembuat":["IPB University"],"trl":null,"url":"https://www.ipb.ac.id/news/index/2025/11/inovator-ipb-university-ciptakan-palka-pendingin-tenaga-surya-mampu-tekan-30-persen-biaya-operasional-nelayan/","tanggal":"2026-11-08"},{"id":"in_pats_banyubiru","nama":"Pompa Air Tenaga Surya (PATS) Banyubiru","jenis":"alat","status":"terpasang","tahun":2026,"ringkasan":"Pompa Air Tenaga Surya (PATS) dibangun mahasiswa KKN-T IDBU 66 UNDIP di Desa Banyubiru, Kabupaten Semarang, untuk irigasi lahan padi kelompok tani Dusun Randusari. Pembangunan selesai 21 Juli 2026 dan diresmikan 23 Juli 2026 di Balai Desa Banyubiru.","pembuat":["Universitas Diponegoro"],"trl":null,"url":"https://undip.ac.id/post/58470/pompa-air-tenaga-surya-pats-bantuan-undip-atasi-keterbatasan-irigasi-petani-desa-banyubiru.html","tanggal":"2026-11-08"},{"id":"in_pengairan_surya_pacitan","nama":"Sistem pengairan panel surya dan IoT Desa Cokrokembang","jenis":"sistem","status":"terpasang","tahun":2026,"ringkasan":"Program EPICS in IEEE 2025 sampai 2026 oleh tim ITS bersama Telkom University Surabaya memasang PLTS empat panel surya terintegrasi IoT di Desa Cokrokembang, Pacitan. Sistem memompa air sumur bor ke sekitar 20 petak sawah dan memantau kualitas air secara berkala.","pembuat":["Institut Teknologi Sepuluh Nopember"],"trl":null,"url":"https://www.its.ac.id/epics-in-ieee-2026-hadirkan-sistem-pengairan-berbasis-panel-surya-dan-iot-untuk-petani-pacitan/","tanggal":"2026-11-08"},{"id":"in_pengering_rumput_laut_brebes","nama":"Pengering rumput laut surya-biomassa","jenis":"alat","status":"terpasang","tahun":2026,"ringkasan":"Unit Pengering Rumput Laut Surya-Biomassa dengan Dehumidifikasi Udara dikembangkan tim Prof. Moh. Djaeni dari UNDIP bersama Unwahas. Unit diresmikan di Desa Randusanga Kulon, Brebes, bersama Ditjen PDSPKP Kementerian Kelautan dan Perikanan serta pemerintah daerah.","pembuat":["Universitas Diponegoro"],"trl":null,"url":"https://undip.ac.id/post/59212/peneliti-undip-terapkan-teknologi-pengering-rumput-laut-surya-biomassa-tingkatkan-nilai-tambah-produk-budidaya-kelautan-di-pesisir-brebes.html","tanggal":"2026-11-08"},{"id":"in_pengering_surya_hibrida_temanggung","nama":"Pengering surya hibrida kabinet portabel","jenis":"alat","status":"terpasang","tahun":2026,"ringkasan":"Pengering kabinet surya hibrida portabel berkapasitas 20 rak, dipadukan sumber gas, diserahkan LPPM UNDIP kepada kelompok tani di Desa Wonosari, Temanggung. Alat dipakai mengeringkan kopi, jagung, dan hasil tani lain secara higienis.","pembuat":["Universitas Diponegoro"],"trl":null,"url":"https://undip.ac.id/language/en/post/60034/supporting-food-security-undip-provides-temanggung-farmers-with-portable-hybrid-solar-cabinet-dryer.html","tanggal":"2026-11-08"},{"id":"in_penyimpanan_surya_pju_sajen","nama":"Penyimpanan energi surya untuk PJU Desa Sajen","jenis":"sistem","status":"terpasang","tahun":2026,"ringkasan":"Prodi D3 Teknik Elektro Industri PENS memasang PJU bertenaga surya dengan penyimpanan baterai di kawasan peternakan dan pertanian Desa Sajen, Kecamatan Pacet, Mojokerto, pada 6 Agustus 2026.","pembuat":["Politeknik Elektronika Negeri Surabaya"],"trl":null,"url":"https://www.pens.ac.id/2026/08/07/tingkatkan-akses-penerangan-pens-implementasikan-sistem-penyimpanan-energi-di-desa-sajen/","tanggal":"2026-11-08"},{"id":"in_pju_plts_cukir","nama":"PJU berbasis PLTS Masjid At-Taqwa","jenis":"sistem","status":"terpasang","tahun":2026,"ringkasan":"Tim Prodi Sarjana Terapan Teknik Elektronika PENS yang diketuai Ibnu Cipta Ramadhan memasang penerangan jalan umum berbasis PLTS di kawasan Masjid At-Taqwa, Desa Cukir, Kecamatan Diwek, Jombang, pada 10 Oktober 2026.","pembuat":["Politeknik Elektronika Negeri Surabaya"],"trl":null,"url":"https://www.pens.ac.id/2026/10/30/manfaatkan-energi-matahari-pens-hadirkan-penerangan-jalan-berbasis-plts-di-masjid-at-taqwa-desa-cukir/","tanggal":"2026-11-08"},{"id":"in_pju_surya_pacet","nama":"PJU panel surya Kecamatan Pacet","jenis":"sistem","status":"terpasang","tahun":2026,"ringkasan":"Prodi Sarjana Terapan Teknik Elektro Industri PENS memasang PJU berbasis panel surya di kawasan peternakan dan pertanian Desa Sajen, Kecamatan Pacet, Mojokerto, pada 6 Agustus 2026, berdasarkan observasi lapangan dan koordinasi dengan pemerintah desa.","pembuat":["Politeknik Elektronika Negeri Surabaya"],"trl":null,"url":"https://www.pens.ac.id/2026/08/07/dukung-energi-bersih-pens-terapkan-pju-panel-surya-di-kawasan-peternakan-kecamatan-pacet/","tanggal":"2026-11-08"},{"id":"in_plts_hybrid_lele_jombang","nama":"PLTS hybrid pompa kolam lele","jenis":"sistem","status":"terpasang","tahun":2026,"ringkasan":"Pranata Laboratorium Pendidikan PENS memasang satu unit PLTS Hybrid untuk pompa sirkulasi air kolam lele Kelompok Barokah Lele di Dusun Gabus, Desa Tunggorono, Jombang. Kegiatan berlangsung 24 Oktober 2026 dan dipimpin Agus Fitriyanto.","pembuat":["Politeknik Elektronika Negeri Surabaya"],"trl":null,"url":"https://www.pens.ac.id/2026/10/31/plts-hybrid-pens-bantu-pembudidaya-lele-di-jombang-tekan-biaya-operasional-dan-jaga-sirkulasi-air-kolam/","tanggal":"2026-11-08"},{"id":"in_tedapis_ipb","nama":"Tenda Darurat Pintar Bertenaga Panel Surya (Tedapis)","jenis":"alat","status":"purwarupa","tahun":2019,"ringkasan":"TEDAPIS (Tenda Darurat Pintar Bertenaga Panel Surya) adalah tenda pengungsian bertenaga panel surya dengan piranti pintar, karya mahasiswa Departemen Fisika FMIPA IPB University dalam PKM Karsa Cipta. Tim dipimpin Aldi Destia Lesmana dengan pembimbing Dr. Ir. Irzaman.","pembuat":["IPB University"],"trl":null,"url":"https://www.ipb.ac.id/news/index/2019/07/mahasiswa-ipb-university-ciptakan-tenda-darurat-pintar-bertenaga-panel-surya-sediakan-energi-listrik-di-tempat-bencana/db2e07a5b98f62882174b7d601b0b2b6/","tanggal":"2026-11-08"},{"id":"in_tkdn_027","nama":"Inverter Gridtech Indonesia","jenis":"alat","status":"dikomersialkan","tahun":2026,"ringkasan":"Produk inverter dalam negeri dari PT Gridtech Indonesia (Banten), memiliki 1 sertifikat TKDN dengan nilai 33.96 persen (tipe: Panel Inverter GBINV).","pembuat":["PT Gridtech Indonesia"],"trl":9,"url":"https://tkdn.kemenperin.go.id/sertifikat?q=inverter&page=6","tanggal":"2026-11-07"},{"id":"in_tkdn_028","nama":"Prolink (inverter)","jenis":"alat","status":"dikomersialkan","tahun":2026,"ringkasan":"Produk inverter dalam negeri dari PT Microvision Indonesia (DKI Jakarta), memiliki 1 sertifikat TKDN dengan nilai 33.31 persen (tipe: Inspire H3T-6KW).","pembuat":["PT Microvision Indonesia"],"trl":9,"url":"https://tkdn.kemenperin.go.id/sertifikat?q=inverter&page=6","tanggal":"2026-11-07"},{"id":"in_tkdn_029","nama":"Inverter Tirta Surya Cipta","jenis":"alat","status":"dikomersialkan","tahun":2026,"ringkasan":"Produk inverter dalam negeri dari PT Tirta Surya Cipta (Jawa Barat), memiliki 1 sertifikat TKDN dengan nilai 35.69 persen (tipe: Panel Inverter 0,75 KW - 375 KW).","pembuat":["PT Tirta Surya Cipta"],"trl":9,"url":"https://tkdn.kemenperin.go.id/sertifikat?q=inverter&page=6","tanggal":"2026-11-07"},{"id":"in_tkdn_030","nama":"Soleilight (modul surya)","jenis":"produk","status":"dikomersialkan","tahun":2025,"ringkasan":"Produk modul surya dalam negeri dari CV Dua Cipta Karya (Jawa Tengah), memiliki 1 sertifikat TKDN dengan nilai 41.53 persen (tipe: LTSHE).","pembuat":["CV Dua Cipta Karya"],"trl":9,"url":"https://tkdn.kemenperin.go.id/sertifikat?q=panel%20surya&page=6","tanggal":"2026-11-07"}],"berita":[{"id":"be0c833446","judul":"Video:Keunggulan Panel Surya Lokal Bersaing di Pasar Domestik - Ekspor","url":"https://www.cnbcindonesia.com/news/20261104112725-8-782207/videokeunggulan-panel-surya-lokal-bersaing-di-pasar-domestik--ekspor","media":"CNBC Indonesia","terbit":"2026-11-07","diambil":"2026-11-07"},{"id":"a272bedfb3","judul":"RI Kejar Target PLTS 100 GWp dalam 3 Tahun , Caranya ? : Okezone Economy","url":"https://economy.okezone.com/read/2026/11/07/320/3252619/ri-kejar-target-plts-100-gwp-dalam-3-tahun-caranya","media":"economy.okezone.com","terbit":"2026-11-07","diambil":"2026-11-07"},{"id":"fd3ceaef11","judul":"AESI Ajak Jurnalis Nasional dan Daerah Kawal Proyek PLTS","url":"https://www.ruangenergi.com/aesi-ajak-jurnalis-nasional-dan-daerah-kawal-proyek-plts/","media":"Ruang Energi","terbit":"2026-11-07","diambil":"2026-11-07"},{"id":"9e51a5b2f1","judul":"Ajak Jurnalis Nasional dan Daerah Kawal Proyek PLTS , AESI Gelar Diskursus Energi Surya Nasional","url":"https://analisadaily.com/berita/baca/2026/11/06/1079236/ajak-jurnalis-nasional-dan-daerah-kawal-proyek-plts-aesi-gelar-diskursus-energi-surya-nasional/","media":"analisadaily.com","terbit":"2026-11-06","diambil":"2026-11-07"},{"id":"4290ca67f5","judul":"PLTS Terapung Jatigede 100 MW Segera Dimulai , Jatiluhur Masih Dikaji","url":"https://ecologic.harianjogja.com/r-1276207/plts-terapung-jatigede-100-mw-segera-dimulai-jatiluhur-masih-dikaji","media":"ecologic.harianjogja.com","t